<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Cross-Platform Parallel Execution Suite" parallel="tests" thread-count="2" verbose="1">
    <listeners>
        <listener class-name="com.company.mobile.listeners.TestListener"/>
        <listener class-name="com.company.mobile.listeners.AnnotationTransformer"/>
    </listeners>

    <test name="Android Tests">
        <parameter name="platform" value="ANDROID"/>
        <packages>
            <package name="com.company.mobile.tests.auth"/>
            <package name="com.company.mobile.tests.echo"/>
            <package name="com.company.mobile.tests.hybrid"/>
        </packages>
    </test>

    <test name="iOS Tests">
        <parameter name="platform" value="IOS"/>
        <packages>
            <package name="com.company.mobile.tests.auth"/>
            <package name="com.company.mobile.tests.echo"/>
            <package name="com.company.mobile.tests.hybrid"/>
        </packages>
    </test>
</suite>
